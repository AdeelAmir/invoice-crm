{
  "name": "invoice-demo-crm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3010",
    "build": "next build",
    "start": "next start -p 3010",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:seed:sample": "tsx scripts/seed-sample.ts",
    "db:reset": "prisma migrate reset --force && prisma db seed",
    "db:studio": "prisma studio",
    "webhook:test": "tsx scripts/send-payment-webhook.ts",
    "agent:plan": "tsx agent-runner/ant.ts apply --dry-run -v agents/invoice-agent.md environments/invoice-agent.yaml",
    "agent:apply": "tsx agent-runner/ant.ts apply agents/invoice-agent.md environments/invoice-agent.yaml",
    "agent:check": "tsx agent-runner/check.ts",
    "agent:once": "tsx agent-runner/run-once.ts",
    "agent:worker": "tsx agent-runner/worker.ts",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-slot": "^1.5.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^6.2.12",
    "lucide-react": "^1.58.0",
    "next": "16.4.2",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.33.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.8",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "prisma": "^7.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
