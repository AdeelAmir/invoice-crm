# Copy to .env and fill in.

# PostgreSQL: app database and a separate one for the integration tests
DATABASE_URL="postgresql://invoice_demo_user:CHANGE_ME@localhost:5432/invoice_demo?schema=public"
DATABASE_URL_TEST="postgresql://invoice_demo_user:CHANGE_ME@localhost:5432/invoice_demo_test?schema=public"

# Admin session signing key (32+ characters):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=""

# Admin account created by the seeder (npm run db:seed)
ADMIN_NAME="Ledgerly Admin"
ADMIN_EMAIL="admin@ledgerly.app"
ADMIN_PASSWORD=""

# CRM API key for the automation (x-api-key header), 16+ characters
CRM_API_KEY=""

# Shared secret for signing payment webhooks (POST /api/webhooks/payment), 16+ characters
PAYMENT_WEBHOOK_SECRET=""

# Invoice processing
INVOICE_MAX_RETRIES=3
INVOICE_PROCESSING_TIMEOUT_MINUTES=15
INVOICE_RETRY_BASE_SECONDS=60
MOCK_GATEWAY_LATENCY_MS=800
# Overdue reminders: one every N days after the due date, at most M per invoice
INVOICE_REMINDER_INTERVAL_DAYS=3
INVOICE_REMINDER_MAX=3
# How often the agent worker processes due invoices, in seconds (5 min to 24 h)
# INVOICE_POLL_INTERVAL=300

# Timezone for admin-facing times (audit log)
ADMIN_TIMEZONE="America/Toronto"

# --- Invoice agent (Claude Managed Agent) ---
ANTHROPIC_API_KEY=""
# Public URL of this CRM (links in emails) and the mock payment page base
APP_URL="http://localhost:3010"
PAYMENT_LINK_BASE="http://localhost:3010/pay"
BUSINESS_NAME="Ledgerly"
# Where escalations and failure alerts go (defaults to ADMIN_EMAIL)
# ADMIN_ALERT_EMAIL=""

# Email: "resend" sends for real; anything else keeps emails in the CRM outbox only
EMAIL_PROVIDER="outbox"
RESEND_API_KEY=""
EMAIL_FROM="Ledgerly Billing <onboarding@resend.dev>"
# Send every email to this inbox instead (Resend without a verified domain
# only delivers to your own account email)
EMAIL_TEST_RECIPIENT=""

# Filled in after `npm run agent:apply` (IDs from claude-lock.json)
AGENT_ID=""
AGENT_ENVIRONMENT_ID=""
# Runner tuning (defaults shown)
# AGENT_POLL_SECONDS=5
# AGENT_REMINDER_CHECK_MINUTES=5
# AGENT_SESSION_BUDGET_CENTS=200
# AGENT_TASK_TIMEOUT_MINUTES=10
# AGENT_TASK_MAX_ATTEMPTS=3
# AGENT_CONSOLE_WORKSPACE=default
